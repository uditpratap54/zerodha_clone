(            tempMin: 25.05, // Default min temp) Tj
T* (            tempMax: 25.05, // Default max temp) Tj
T* (            humidity: 47, // Default humidity) Tj
T* (            weather: "haze", // Default weather text) Tj
T* (        }\);) Tj
T* () Tj
T* (        let updateInfo = \(newInfo\) => { // Child se updated data aane par chalega) Tj
T* (            setWeatherInfo\(newInfo\); // Parent state update hogi) Tj
T* (        }) Tj
T* () Tj
T* (Snippet B: API fetch) Tj
T* () Tj
T* (    let [city, setCity] = useState\(""\); // User input city state) Tj
T* (    let [error, setError] = useState\(false\); // Error show karne ke liye state) Tj
T* (    const API_URL = "https://api.openweathermap.org/data/2.5/weather"; // Weather endpoint) Tj
T* (    const API_KEY = "6ae9cb6fb6c691bf03dadb057ab5772b"; // API key currently hardcoded hai) Tj
T* () Tj
T* (    let getWeatherInfo = async \(\) => {) Tj
T* (        let response = await fetch\(${API_URL}?q=${city}&appid=${API_KEY}&units=metric\); //) Tj
T* (        City ke basis par request) Tj
T* (        let jsonResponse = await response.json\(\); // JSON parse hua) Tj
T* () Tj
T* (        let result = {) Tj
T* (            city: city, // City save hui) Tj
T* (            temp: jsonResponse.main.temp, // Current temp extract hua) Tj
T* (            tempMin: jsonResponse.main.temp_min, // Min temp extract hua) Tj
T* (            tempMax: jsonResponse.main.temp_max, // Max temp extract hua) Tj
T* (            humidity: jsonResponse.main.humidity, // Humidity extract hui) Tj
T* (            feelslike: jsonResponse.main.feels_like, // Feels-like value extract hui) Tj
T* (            weather: jsonResponse.weather[0].description, // Description extract hui) Tj
T* (        };) Tj
T* (        return result; // Simplified result return hua) Tj
T* (    };) Tj
T* () Tj
T* (Snippet C: submit handler) Tj
T* () Tj
T* (    let handleSubmit = async \(evt\) => {) Tj
T* (        evt.preventDefault\(\); // Browser page reload roka) Tj
T* (        try {) Tj
T* (            let newInfo = await getWeatherInfo\(\); // Fresh weather data fetch hua) Tj
T* (            updateInfo\(newInfo\); // Parent ko update diya) Tj
T* (            setCity\(""\); // Input reset hua) Tj
T* (        } catch \(err\) {) Tj
T* (            setError\(true\); // Failure par error message show hoga) Tj
T* (        }) Tj
T* (    };) Tj
T* () Tj
T* (Snippet D: conditional UI) Tj
T* () Tj
T* (    image={) Tj
T* (       info.humidity > 80 // High humidity check) Tj
T* (       ? RAIN_URL // Rain image) Tj
T* (       : info.temp > 15 // Warmer weather check) Tj
