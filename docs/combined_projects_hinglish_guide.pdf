T* (    }\);) Tj
T* () Tj
T* (    const sessionConfig = { // Session ke liye config object) Tj
T* (      store, // Session memory ki jagah MongoDB me save hoga) Tj
T* (      secret: process.env.SESSION_SECRET || "mysupersecretcode", // Cookie sign karne ke) Tj
T* (      liye secret) Tj
T* (      resave: false, // Har request par unnecessary resave avoid hota hai) Tj
T* (      saveUninitialized: true, // New session ko save karne ka behavior define hota hai) Tj
T* (      cookie: {) Tj
T* (        httpOnly: true, // Browser JS cookie ko directly read na kar sake) Tj
T* (        maxAge: 7 * 24 * 60 * 60 * 1000, // Session 1 week tak valid rahe) Tj
T* (      },) Tj
T* (    };) Tj
T* () Tj
T* (    app.use\(session\(sessionConfig\)\); // Session middleware activate hua) Tj
T* (    app.use\(flash\(\)\); // Flash messaging activate hui) Tj
