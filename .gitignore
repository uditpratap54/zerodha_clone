# ============================================
#  ZERODHA CLONE — ROOT .gitignore
#  Covers backend, frontend, and dashboard
# ============================================

# ---- SECRETS (NEVER commit these) ----------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ---- DEPENDENCIES --------------------------
node_modules/
**/node_modules/

# ---- BUILD OUTPUTS -------------------------
/build
**/build/

# ---- LOGS ----------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ---- OS FILES ------------------------------
.DS_Store
Thumbs.db

# ---- EDITOR --------------------------------
.vscode/
.idea/
*.swp
*.swo

# ---- MISC ----------------------------------
.pnp
.pnp.js
/coverage
